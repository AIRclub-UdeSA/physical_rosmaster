# Per-robot ROSMASTER X3 autostart configuration.
# Copy to /etc/rosmaster/platform.env (root-owned, mode 0640) and replace
# every REPLACE_WITH_* placeholder with the value recorded for this robot
# in docs/setup_guide_ros2_humble_autostart.md sections 4-5. Never commit
# the filled-in copy; only this template belongs in the repository.

# Docker container running the Yahboom ROS 2 Humble image.
ROSMASTER_CONTAINER_NAME=rosmaster_humble

# Workspace path inside the container.
ROSMASTER_WORKSPACE=/root/yahboomcar_ws

# Stable motor-controller serial path. Prefer /dev/serial/by-id/... ; fall
# back to the udev KERNELS-bound /dev/robot/motor alias only for CH340
# units with no distinguishable serial (see 99-rosmaster-x3.rules.example).
ROSMASTER_MOTOR_PORT=/dev/serial/by-id/REPLACE_WITH_MOTOR_CONTROLLER_ID

# Stable A1 LiDAR serial path or udev alias.
ROSMASTER_LIDAR_PORT=/dev/robot/lidar

# Astra RGB-D camera serial number selected per robot (see setup guide
# section 4). Must not be left blank at acceptance.
ROSMASTER_ASTRA_SERIAL=REPLACE_WITH_ASTRA_SERIAL

# RGBLight effect published once, at boot, after the platform contract
# passes. 0=off 1=flowing 2=marquee 3=breathing 4=gradient 5=starlight
# 6=battery-display (see Mcnamu_driver_X3.py rgb_light_callback). Default
# below is pending live confirmation on x3-c of what effect=6 looks like.
READY_RGB_EFFECT=6
