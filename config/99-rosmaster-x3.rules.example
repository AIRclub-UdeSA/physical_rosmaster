# ROSMASTER X3 udev template. This file is intentionally nonfunctional until
# every identity placeholder in the selected rules is replaced with a value
# observed on one robot. Install the edited file as
# /etc/udev/rules.d/99-rosmaster-x3.rules.

# Typical CH340 motor controller. Prefer a real unique serial when it exists.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{serial}=="MOTOR_SERIAL", SYMLINK+="robot/motor", GROUP="dialout", MODE="0660"

# Some CH340 controllers expose no serial at all. In that case, comment out the
# serial rule above and bind the alias to the controller's dedicated physical
# USB port. Obtain the KERNELS value from the host's udev attribute walk and
# verify it again after a reboot before acceptance.
# SUBSYSTEM=="tty", KERNELS=="MOTOR_USB_PORT", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="robot/motor", GROUP="dialout", MODE="0660"

# Typical CP210x adapter used by a Slamtec A1. Confirm on the actual unit.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="LIDAR_SERIAL", SYMLINK+="robot/lidar", GROUP="dialout", MODE="0660"

# Install the pinned Orbbec driver's own USB rules for Astra permissions. Camera
# selection is by ROSMASTER_ASTRA_SERIAL, not by a /dev/video* index.
