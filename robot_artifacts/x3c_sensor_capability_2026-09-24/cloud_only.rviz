Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: DepthCloud
      Enabled: true
      Topic:
        Value: /cam_1/depth/color/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Filter size: 10
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Queue Size: 10
      Selectable: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: cam_1_depth_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 2
        Y: 0
        Z: 0
      Pitch: 0.4
      Yaw: 3.14
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 700
  Width: 1000
